<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /

	# Google Search Console legacy samples from the previous site.
	RewriteRule ^blog/bighorn-/?$ https://greatwildlifephotos.com/gallery [R=301,L]
	RewriteRule ^about-the-artist/?$ https://greatwildlifephotos.com/about [R=301,L]
	RewriteRule ^warehouse-open-edition-prints/art_print_products/ram-symmetry-lbs-2171/?$ https://greatwildlifephotos.com/gallery [R=301,L]

	# Keep the canonical host and sitemap endpoint unambiguous for crawlers.
	RewriteRule ^sitemap\.xml$ https://api.greatwildlifephotos.com/sitemap.xml [R=301,L]
	RewriteCond %{HTTP_HOST} ^www\.greatwildlifephotos\.com$ [NC]
	RewriteRule ^ https://greatwildlifephotos.com%{REQUEST_URI} [R=301,L]

	RewriteCond %{REQUEST_FILENAME} -f [OR]
	RewriteCond %{REQUEST_FILENAME} -d
	RewriteRule ^ - [L]

	RewriteRule ^(gallery|cart|checkout|order-success|order-receipt|contact|about|faq|privacy|terms|blog)(/.*)?$ /index.html [L]
	RewriteRule ^photo/[^/]+/?$ /index.html [L]
	RewriteRule ^confirmation/[^/]+/?$ /index.html [L]

	# A URL that does not exist must return 404 — not a redirect to the homepage.
	#
	# This rule previously read: RewriteRule ^.+$ / [R=301,L]
	# i.e. EVERY unknown path 301'd to /. That is the pattern Google documents as a
	# soft 404: the engine asks for a page that is gone, is sent to the homepage, and
	# records it as a soft error rather than a clean removal. It also means a user who
	# mistypes a URL is silently dumped on the homepage with no indication anything
	# was wrong. Measured 2026-08-26: /definitely-not-real-xyz123,
	# /shop/nonexistent-product-abc and /blog/no-such-post all resolved 200.
	#
	# ErrorDocument serves the SPA shell so the 404 is branded — React Router's
	# catch-all route renders NotFound — while the HTTP status is honestly 404.
	#
	# ⚠ Real routes are NOT affected: the -f/-d test above already short-circuits
	# every prerendered page and asset (all 189 of them, including /license,
	# /returns and /shipping, which are prerendered directories rather than
	# allowlisted above), and the SPA allowlist covers the client-routed paths.
	ErrorDocument 404 /index.html
	RewriteRule ^.+$ - [R=404,L]
</IfModule>

<IfModule mod_headers.c>
	Header set X-Powered-By "Hostinger Horizons"

	# Cache everything on CDN by default
	Header set Cache-Control "public, s-maxage=604800, max-age=0"

	# Cache in browser all assets
	<If "%{REQUEST_URI} =~ m#^/assets/.*$#">
		Header set Cache-Control "public, max-age=604800"
	</If>
</IfModule>
